# Copy to .env and adjust: `cp .env.example .env`
# Settings use the APP__SECTION__KEY convention (config crate, separator "__").

# HTTP server
APP__APPLICATION__HOST=0.0.0.0
APP__APPLICATION__PORT=8080

# PostgreSQL (matches docker-compose.yml)
APP__DATABASE__HOST=localhost
APP__DATABASE__PORT=5432
APP__DATABASE__USERNAME=app
APP__DATABASE__PASSWORD=app
APP__DATABASE__DATABASE_NAME=app
APP__DATABASE__MAX_CONNECTIONS=5

# Redis (matches docker-compose.yml)
APP__REDIS__HOST=localhost
APP__REDIS__PORT=6379

# RabbitMQ (matches docker-compose.yml)
APP__RABBITMQ__HOST=localhost
APP__RABBITMQ__PORT=5672
APP__RABBITMQ__USERNAME=app
APP__RABBITMQ__PASSWORD=app

# Host ports published by docker-compose.yml; override when the standard
# ports are already taken on your machine (keep APP__*_PORT in sync).
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672

# Logging: tracing EnvFilter syntax
RUST_LOG=info,tower_http=debug

# Used by sqlx-cli (`sqlx migrate run`, `cargo sqlx prepare`)
DATABASE_URL=postgres://app:app@localhost:5432/app

# Optional distributed tracing: enable the `infra/otlp` feature and point to a
# collector (e.g. `docker run -p 4317:4317 jaegertracing/all-in-one`).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
